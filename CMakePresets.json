{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (multi-config)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CPM_SOURCE_CACHE": "${sourceDir}/.cpm-cache"
      }
    },
    {
      "name": "vs2022",
      "inherits": "default",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "xcode",
      "inherits": "default",
      "displayName": "Xcode",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "ninja",
      "inherits": "default",
      "displayName": "Ninja Multi-Config",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "xcode-debug", "configurePreset": "xcode", "configuration": "Debug" },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "xcode-debug", "configurePreset": "xcode", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
